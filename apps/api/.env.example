# Local Supabase (`supabase start`) Postgres connection.
# In production, DATABASE_URL points at the pooled connection (port 6543)
# and DIRECT_URL at the direct connection (port 5432) — locally there is
# only one Postgres instance, so both point at the same URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service_role-key-from-supabase-start"

JWT_SECRET="replace-with-a-long-random-string-in-every-real-environment"
JWT_EXPIRES_IN="8h"

# Used for AES-256-GCM field-level encryption (national ID, etc.) and the
# deterministic HMAC hash used for uniqueness/lookups. Rotating this key
# without a re-encryption migration will make existing encrypted fields
# unreadable — treat it like a database credential.
FIELD_ENCRYPTION_KEY="replace-with-a-long-random-string-in-every-real-environment"

PORT=3000
WEB_ORIGIN="http://localhost:3001"
