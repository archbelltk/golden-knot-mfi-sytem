{
  "name": "golden-knot-mfi-build",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "pnpm --filter @golden-knot/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm build:shared && pnpm --filter api dev",
    "dev:web": "pnpm build:shared && pnpm --filter web dev",
    "build": "pnpm build:shared && pnpm -r --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "unrs-resolver"
    ]
  }
}
